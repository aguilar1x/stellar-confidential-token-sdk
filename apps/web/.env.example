# Every value here has a working default, so the site runs from a fresh clone
# with no .env at all. Set these only to point the site at your own deployment.
#
# The defaults reference Stellar TESTNET and two testnet accounts whose seeds are
# committed to this repository on purpose — the page runs the real client, which
# needs a real signer to derive keys and decrypt its own events. Both accounts
# hold nothing, and neither exists on mainnet.
#
# If you deploy this yourself and want your own accounts, set GUEST_SECRET and
# BUILDING_SECRET. Never put a seed here that holds anything: .env is gitignored,
# but a seed in an environment variable is still readable by anything that runs
# in the deployment.

# ── Network ──────────────────────────────────────────────────────────────────
# These two move together. An RPC on one network with another network's
# passphrase produces signatures that node rejects.
# RPC_URL="https://soroban-testnet.stellar.org"
# NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Contracts ────────────────────────────────────────────────────────────────
# TOKEN_CONTRACT="CAPLH4ZW7EDSYRBCQN77Y4K7W5RNA6TO76JQ5CGHHIPY4ALWVQZ2WFAY"
# VERIFIER_CONTRACT="CC6NG5LWW6QA4YSW2RP7RR2CE5FF6IHAGJEYY4STG6QP563EWSZU5DG7"
# AUDITOR_CONTRACT="CAEYYDRJPJ73UR3UZWYLSIWW4CHUZILTSENAWOUYXGSR4LPY4HQ23R4L"

# ── The building the demo audits ─────────────────────────────────────────────
# Falls back to examples/condominium-state.json, written by
# `node examples/condominium.mjs`.
# BUILDING_SECRET=""
# BUILDING_ADDRESS=""
# BUILDING_FROM_LEDGER=""

# ── The account /api/pay spends from ─────────────────────────────────────────
# Falls back to examples/guest-state.json, written by
# `node examples/setup-guest.mjs`. Fund it well above what the demo will spend:
# when it runs dry the page says so rather than failing quietly.
# GUEST_SECRET=""
# GUEST_FROM_LEDGER=""

# ── Archives ─────────────────────────────────────────────────────────────────
# The second, independently deployed archive INDEXER.md §7 asks for. Empty
# disables its card, so an outage degrades the page instead of breaking it.
# NEXT_PUBLIC_EXTERNAL_ARCHIVE="https://confidential-token-archive.aaguilar1x.workers.dev"

# Where the built-in archives start scanning. The demo account's history is
# closed, so starting at its first ledger avoids rescanning 120,000 empty ones.
# INDEX_FROM_LEDGER="3976100"

# ── Links ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_EXPLORER="https://stellar.expert/explorer/testnet/tx"
